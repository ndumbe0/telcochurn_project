# =============================================================================
# Telco Churn Project - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# Google Gemini API Key (optional, for AI assistant features)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Database credentials (if using database connection)
# SERVER=your_database_server
# DATABASE=your_database_name
# USERNAME=your_username
# PASSWORD=your_password
