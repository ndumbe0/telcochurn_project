  <worksheets>
    <worksheet name='Churn Rate by Contract'>
      <table>
        <view>
          <datasources>
            <datasource caption='telco_churn_unified' name='telco_churn_unified'/>
          </datasources>
          <datasource-dependencies datasource='telco_churn_unified'>
        <column caption='Churned (0/1)' datatype='integer' name='[churned]' role='measure' type='quantitative'/>
        <column-instance column='[churned]' derivation='Avg' name='[avg:churned:qk]' pivot='key' type='quantitative'/>
        <column caption='Contract' datatype='string' name='[contract]' role='dimension' type='nominal'/>
        <column-instance column='[contract]' derivation='None' name='[none:contract:nk]' pivot='key' type='quantitative'/>
          </datasource-dependencies>
          <aggregation value='true'/>
        </view>
        <style/>
        <panes/>
        <rows>[telco_churn_unified].[avg:churned:qk]</rows>
        <cols>[telco_churn_unified].[none:contract:nk]</cols>
      </table>
    </worksheet>
